      "description": "Staff role mappings protected for admin only"
    },
    "/admins/{adminId}": {
      "schema": "CatalogRecord",
      "description": "System administrator entries"
    },
    "/profiles/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles isolated to owner or admin"
    }
  }
}
