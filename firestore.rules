rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default-Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isVerifiedUser() {
      return isSignedIn();
    }
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'help.boialo@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role in ['super_admin', 'admin'])
      );
    }

    function isValidCatalogDoc(data, docId) {
      return data.keys().hasAll(['id']) &&
             data.id is string &&
             data.id.size() >= 1 &&
             data.id.size() <= 128 &&
             data.id == docId;
    }

    function isValidProfile(data, userId) {
      return data.keys().hasAll(['id', 'email']) &&
             data.keys().hasOnly(['id', 'email', 'full_name', 'phone', 'avatar_url', 'created_at', 'updated_at']) &&
             data.id is string && data.id.size() <= 128 && data.id == userId &&
             data.email is string && data.email.size() <= 320 &&
             (!('full_name' in data) || (data.full_name is string && data.full_name.size() <= 200)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 32));
    }

    function isValidOrder(data, docId) {
      return data.keys().hasAll(['id', 'user_id', 'status']) &&
             data.id is string && data.id.size() <= 128 && data.id == docId &&
             data.user_id is string && data.user_id.size() <= 128 &&
             data.status is string && data.status.size() <= 64;
    }

    function isValidLoyaltyPoint(data, docId) {
      return data.keys().hasAll(['id', 'user_id', 'points']) &&
             data.id is string && data.id.size() <= 128 && data.id == docId &&
             data.user_id is string && data.user_id.size() <= 128 &&
             data.points is number;
    }

    function isValidReferralCode(data, docId) {
      return data.keys().hasAll(['id', 'code']) &&
             data.id is string && data.id.size() <= 128 && data.id == docId &&
             data.code is string && data.code.size() <= 64;
    }

    // Connection verification endpoint
    match /test/{docId} {
      allow get: if isValidId(docId);
    }

    // Admins collection
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list, create, update, delete: if isAdmin() && isValidId(adminId);
    }

    // Staff user roles collection
    match /user_roles/{docId} {
      allow get, list: if isSignedIn() && isValidId(docId) && (isAdmin() || resource.data.user_id == request.auth.uid);
      allow create, update, delete: if isAdmin() && isValidId(docId);
    }

    // Private User Profiles (PII Isolated to Owner or Admin)
    match /profiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (resource.data.id == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() && isValidId(userId) && request.auth.uid == userId && isValidProfile(incoming(), userId);
      allow update: if isVerifiedUser() && isValidId(userId) && isValidProfile(incoming(), userId) &&
                    incoming().id == existing().id && (
                      isAdmin() ||
                      (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['full_name', 'phone', 'avatar_url', 'updated_at']))
                    );
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Customer Orders (Guest + Authenticated, with strict state update lock)
    match /orders/{docId} {
      allow get: if isValidId(docId) && (isAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow create: if isValidId(docId) && isValidOrder(incoming(), docId);
      allow update: if isValidId(docId) && (
                      isAdmin() ||
                      (isSignedIn() && existing().user_id == request.auth.uid &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
                       existing().status == 'pending' && incoming().status == 'cancelled')
                    );
      allow delete: if isAdmin() && isValidId(docId);
    }

    match /order_items/{docId} {
      allow get, list: if isValidId(docId) && (isAdmin() || (isSignedIn() && (resource.data.user_id == request.auth.uid || resource.data.userId == request.auth.uid)));
      allow create: if isValidId(docId);
      allow update, delete: if isAdmin() && isValidId(docId);
    }

    match /abandoned_checkouts/{docId} {
      allow get, list: if isAdmin() && isValidId(docId);
      allow create, update: if isValidId(docId);
      allow delete: if isAdmin() && isValidId(docId);
    }

    // Customer Loyalty Points ledger (Owner or Admin read, strict schema creation)
    match /loyalty_points/{docId} {
      allow get, list: if isValidId(docId) && (isAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid));
      allow create: if isValidId(docId) && isValidLoyaltyPoint(incoming(), docId) && (isAdmin() || (isSignedIn() && incoming().user_id == request.auth.uid));
      allow update, delete: if isAdmin() && isValidId(docId);
    }

    match /loyalty_settings/{docId} {
      allow get, list: if isValidId(docId);
      allow create, update, delete: if isAdmin() && isValidId(docId);
    }

    // Referral and Friend Invite Program
    match /referral_codes/{docId} {
      allow get, list: if isValidId(docId);
      allow create: if isValidId(docId) && isValidReferralCode(incoming(), docId) && (isAdmin() || (isSignedIn() && incoming().user_id == request.auth.uid));
      allow update: if isValidId(docId) && isValidReferralCode(incoming(), docId) && (isAdmin() || (isSignedIn() && existing().user_id == request.auth.uid));
      allow delete: if isAdmin() && isValidId(docId);
    }

    match /referral_rewards/{docId} {
      allow get, list: if isValidId(docId) && (isAdmin() || (isSignedIn() && (resource.data.referrer_id == request.auth.uid || resource.data.referred_id == request.auth.uid)));
      allow create: if isValidId(docId) && (isAdmin() || (isSignedIn() && (incoming().referrer_id == request.auth.uid || incoming().referred_id == request.auth.uid)));
      allow update, delete: if isAdmin() && isValidId(docId);
    }

    match /referral_settings/{docId} {
      allow get, list: if isValidId(docId);
      allow create, update, delete: if isAdmin() && isValidId(docId);
    }

    // Public Storefront Catalog & Settings (Admin and Store Configuration)
    match /site_settings/{docId} {
      allow read, write: if isValidId(docId);
    }
    match /navigation_menus/{docId} {
      allow read, write: if isValidId(docId);
    }
    match /menu_items/{docId} {
      allow read, write: if isValidId(docId);
    }
    match /footer_sections/{docId} {
      allow read, write: if isValidId(docId);
    }
    match /footer_links/{docId} {
      allow read, write: if isValidId(docId);
    }
    match /banners/{docId} {
      allow read, write: if isValidId(docId);
    }
    match /categories/{docId} {
      allow read, write: if isValidId(docId);
    }
    match /writers/{docId} {
      allow read, write: if isValidId(docId);
    }
    match /publishers/{docId} {
      allow read, write: if isValidId(docId);
    }
    match /products/{docId} {
      allow read, write: if isValidId(docId);
    }
    match /homepage_sections/{docId} {
      allow read, write: if isValidId(docId);
    }
    match /product_types/{docId} {
      allow read, write: if isValidId(docId);
    }
    match /universal_categories/{docId} {
      allow read, write: if isValidId(docId);
    }
    match /universal_products/{docId} {
      allow read, write: if isValidId(docId);
    }
    match /payment_methods/{docId} {
      allow read, write: if isValidId(docId);
    }
    match /courier_providers/{docId} {
      allow read, write: if isValidId(docId);
    }
    match /delivery_zones/{docId} {
      allow read, write: if isValidId(docId);
    }
    match /coupons/{docId} {
      allow read, write: if isValidId(docId);
    }
  }
}
